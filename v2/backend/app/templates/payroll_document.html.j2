<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <title>Kurye Hakediş Belgesi</title>
  </head>
  <body>
    <main class="page">
      <div class="sheet">
        <header class="header">
          <div class="header-left">
            <div class="brand-row">
              <span class="brand-name">ÇAT KAPINDA</span>
            </div>
            <h1 class="title">Kurye Hakediş Belgesi</h1>
            <p class="subtitle">Bu belge aylık kurye ödeme özetini gösterir.</p>
          </div>
          <div class="header-right">
            <div class="period">{{ period }}</div>
            <div class="created-at">Oluşturma: {{ created_at }}</div>
          </div>
        </header>

        <section class="top-section">
          <article class="hero-card">
            <div class="hero-card-inner">
              <div class="hero-label">Net Ödeme</div>
              <div class="hero-amount number">{{ net_payment }}</div>
              <div class="hero-divider"></div>
              <div class="hero-metrics">
                <div class="hero-metric">
                  <div class="hero-metric-label">Hakediş Tutarı</div>
                  <div class="hero-metric-value number">{{ gross_earning }}</div>
                </div>
                <div class="hero-metric">
                  <div class="hero-metric-label">Kesintiler</div>
                  <div class="hero-metric-value number negative">{{ total_deduction }}</div>
                </div>
                <div class="hero-metric">
                  <div class="hero-metric-label">Ödeme Durumu</div>
                  <div class="hero-metric-value positive">Ödeme Hazır</div>
                </div>
              </div>
            </div>
          </article>

          <article class="person-card card">
            <div class="person-head">
              <div class="person-avatar">{{ courier_initials }}</div>
              <div class="person-title-wrap">
                <div class="person-name">{{ courier_name }}</div>
                <div class="person-meta-caption">Personel bilgisi</div>
              </div>
            </div>

            <div class="person-list">
              <div class="info-row">
                <span class="info-label">Kod</span>
                <span class="info-value">{{ courier_code }}</span>
              </div>
              <div class="info-row">
                <span class="info-label">Rol</span>
                <span class="info-value">{{ courier_role }}</span>
              </div>
              <div class="info-row">
                <span class="info-label">Durum</span>
                <span class="status-badge">{{ courier_status }}</span>
              </div>
            </div>
          </article>
        </section>

        <section class="middle-section">
          <article class="card panel-card">
            <div class="panel-head">
              <h2 class="panel-title">Kesinti Kalemleri</h2>
              <div class="panel-side">
                <div class="panel-side-label">Toplam</div>
                <div class="panel-side-value number negative">{{ total_deduction }}</div>
              </div>
            </div>

            <table class="financial-table">
              <thead>
                <tr>
                  <th>Kalem</th>
                  <th>Tutar</th>
                </tr>
              </thead>
              <tbody>
                {% if deduction_rows %}
                {% for item in deduction_rows %}
                <tr>
                  <td>{{ item.label }}</td>
                  <td class="number negative">{{ item.amount }}</td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td>—</td>
                  <td class="number">—</td>
                </tr>
                {% endif %}
              </tbody>
            </table>

            <div class="summary-bar">
              <span>Toplam</span>
              <strong class="number negative">{{ total_deduction }}</strong>
            </div>
          </article>

          <article class="card panel-card">
            <div class="panel-head panel-head-single">
              <h2 class="panel-title">Fatura Bilgisi</h2>
            </div>

            <div class="invoice-list">
              <div class="invoice-row">
                <span>Fatura Matrahı</span>
                <strong class="number">{{ invoice_base }}</strong>
              </div>
              <div class="invoice-row">
                <span>KDV (%20)</span>
                <strong class="number">{{ invoice_vat }}</strong>
              </div>
              <div class="invoice-row">
                <span>Tevkifat</span>
                <strong class="number">{{ tevkifat }}</strong>
              </div>
            </div>

            <div class="invoice-total-box">
              <div class="invoice-total-label">Fatura Toplamı</div>
              <div class="invoice-total-value number">{{ invoice_total }}</div>
            </div>
          </article>
        </section>

        <section class="card operations-card">
          <div class="operations-header">
            <h2 class="panel-title">Operasyon Özeti</h2>
            <p class="operations-note">Ay içinde puantaj görülen operasyon noktaları</p>
          </div>

          <div class="operations-body">
            <div class="operations-restaurant">
              <div class="operations-restaurant-label">Çalışılan Restoran / Şube</div>
              <div class="operations-restaurant-copy">
                {% if restaurants %}
                {% for restaurant in restaurants %}
                <div class="restaurant-line">{{ restaurant }}</div>
                {% endfor %}
                {% else %}
                <div class="restaurant-line">—</div>
                {% endif %}
              </div>
            </div>

            <div class="operations-kpis">
              <div class="op-kpi">
                <div class="op-kpi-label">Toplam Saat</div>
                <div class="op-kpi-value number">{{ total_hours }}</div>
                <div class="op-kpi-foot">saat</div>
              </div>
              <div class="op-kpi">
                <div class="op-kpi-label">Toplam Paket</div>
                <div class="op-kpi-value number">{{ total_packages }}</div>
                <div class="op-kpi-foot">paket</div>
              </div>
              <div class="op-kpi">
                <div class="op-kpi-label">Toplam Şube</div>
                <div class="op-kpi-value number">{{ total_branches }}</div>
                <div class="op-kpi-foot">şube</div>
              </div>
            </div>
          </div>
        </section>

        <footer class="card footer-card">
          <div class="footer-copy">Bu belge, kurye hak edişlerine ilişkin bilgilendirme amacıyla hazırlanmıştır.</div>
        </footer>
      </div>
    </main>
  </body>
</html>
