# Backend environment variables
# Bu dosyayı .env olarak kopyalayıp doldur

# Supabase Postgres bağlantısı (Render'daki DATABASE_URL ile aynı format)
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# CORS — frontend'in çalıştığı origin'ler (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:3000,https://crmcatkapinda.com

# SMS sağlayıcı (NETGSM)
SMS_PROVIDER=netgsm
SMS_API_URL=https://api.netgsm.com.tr
SMS_NETGSM_USERNAME=
SMS_NETGSM_PASSWORD=
SMS_SENDER=CATKAPINDA

# Uygulama ayarları
APP_ENV=development
APP_NAME=Catkapinda CRM
LOG_LEVEL=INFO
